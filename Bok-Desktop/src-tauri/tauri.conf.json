{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bok",
  "version": "0.6.1",
  "identifier": "com.boujoy.bok",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bok",
        "url": "loading.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "backgroundColor": [8, 11, 16, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first AI second brain",
    "longDescription": "Bok is a local-first Markdown second brain with knowledge, memory, search, graph and quick note workflows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bok-preview"],
    "resources": {
      "../build-resources/ui/": "resources/ui/",
      "../build-resources/starter-vault/": "resources/starter-vault/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
